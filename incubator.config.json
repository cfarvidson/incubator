{
  "durationCapMinutes": 120,
  "stopTime": "07:00",
  "harnesses": {
    "dclaude": { "kind": "claude" },
    "wclaude": { "kind": "claude", "env": { "CLAUDE_CONFIG_DIR": "~/.claude-work" } },
    "zcodex": { "kind": "codex", "command": "zcodex" },
    "wcodex": { "kind": "codex", "command": "wcodex" }
  },
  "profiles": {
    "work": {
      "tracker": { "kind": "linear" },
      "cloneRoots": ["~/code", "~/code/TV4"],
      "harness": "wclaude"
    },
    "home": {
      "tracker": {
        "kind": "github",
        "scope": ["cfarvidson/kurir-ios", "cfarvidson/kurir-server"]
      },
      "cloneRoots": ["~/code"],
      "harness": "dclaude"
    }
  },
  "defaultProfile": "work"
}
