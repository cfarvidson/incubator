{
  "durationCapMinutes": 120,
  "stopTime": "07:00",
  "harnesses": {
    "dclaude": { "kind": "claude" },
    "wclaude": {
      "kind": "claude",
      "env": { "CLAUDE_CONFIG_DIR": "~/.claude-work" }
    },
    "zcodex": { "kind": "codex", "command": "zcodex" },
    "wcodex": { "kind": "codex", "command": "wcodex" },
    "grok": {
      "kind": "custom",
      "command": "grok",
      "args": ["-p", "{prompt}", "--output-format", "streaming-messages-json"]
    }
  },
  "profiles": {
    "work": {
      "tracker": { "kind": "linear" },
      "cloneRoots": ["~/code", "~/code/TV4"],
      "harness": "wclaude"
    },
    "work-opus": {
      "tracker": { "kind": "linear" },
      "cloneRoots": ["~/code", "~/code/TV4"],
      "harness": "wclaude",
      "model": "claude-opus-5"
    },
    "private": {
      "tracker": {
        "kind": "github",
        "scope": ["cfarvidson/kurir-ios", "cfarvidson/kurir-server"],
        "assumeAssignee": true
      },
      "cloneRoots": ["~/code"],
      "harness": "dclaude"
    },
    "private-grok": {
      "tracker": {
        "kind": "github",
        "scope": ["cfarvidson/kurir-ios", "cfarvidson/kurir-server"],
        "assumeAssignee": true
      },
      "cloneRoots": ["~/code"],
      "harness": "grok"
    }
  },
  "defaultProfile": "work"
}
